+/* With --hill-report-fd=F, the client runs under Commonhill's `stdio`
+   profile, the one the instruction-count kit's plugin gives a static program
+   (insncap.c), so that everything it can observe is the same on every run:
+
+   - time (clock_gettime, gettimeofday, time, clock_getres) is answered here:
+     every read moves the clock on by a microsecond, the realtime clocks from
+     2026-01-01T00:00:00Z and the others from 0, so a run reads the same times
+     under every tool. Sleeping returns at once. (The time-stamp counter is
+     deterministic in VEX, guest_amd64_helpers.c.)
+   - getrandom fills from a fixed-seed generator.
+   - set_tid_address answers a constant thread id. futex is wait and wake
+     only (plain or with a bitset), on a word in the client's space.
+   - poll reports nothing ready and nothing wrong: otherwise poll on the
+     output would show whether the grader had read it yet, which is a clock.
+   - a thread (clone with CLONE_THREAD) writes "thread" to the report and
+     ends the run with status 136; every other process, signal, socket,
+     timer, resource and file call fails with ENOSYS.
+   - reads are from descriptor 0 only, writes to 1 and 2 only, and mappings
+     anonymous or of descriptor 0.
+
+   Every address the kernel or this file would follow for the client must
+   lie in the client's space, below VG_CLIENT_SPACE_END (where none of
+   Valgrind's memory is), or the call fails with EFAULT; the guard in
+   m_translate.c does the same for the client's own accesses. The report's
+   descriptor itself is moved out of the client's range (VG_(hill_init)).
+
+   With --hill-frames=yes the input is framed, as insncap.c's frames=1: the
+   grader writes it as frames, each an 8-byte little-endian length and that
+   many bytes (a length of 0, or the end, ends the input), and sends the next
+   only after the program's answer to the last. A read returns at most what
+   is left of the current frame, all of it waited for, so what a read returns
+   depends on the program's request and the frames alone. The first read of
+   each frame calls the tool's item hook, which reports its counts then. */
+
+#include "pub_core_basics.h"
+#include "pub_core_vki.h"
+#include "pub_core_vkiscnums.h"
+#include "pub_core_aspacemgr.h"
+#include "pub_core_threadstate.h"
+#include "pub_core_libcbase.h"
+#include "pub_core_libcassert.h"
+#include "pub_core_libcfile.h"
+#include "pub_core_libcprint.h"
+#include "pub_core_options.h"
+#include "pub_core_hill.h"
+#include "pub_core_syscall.h"      // VG_(mk_SysRes_*)
+#include "priv_types_n_macros.h"
+#include "priv_syswrap-hill.h"
+
+#if defined(VGP_amd64_linux)
+
+#define HILL_EXIT_THREAD 136
+#define HILL_TID         2
+#define HILL_BASE_S      1767225600LL      /* 2026-01-01T00:00:00Z */
+#define HILL_NS_PER_S    1000000000LL
+#define HILL_CLOCK_STEP  1000LL            /* ns a clock read moves it on */
+#define HILL_CLOCK_IDS   12                /* Linux's, up to CLOCK_TAI */
+#define HILL_FRAME_CHUNK 65536
+#define HILL_MAP_HUGETLB     0x40000  /* Linux's, which vki doesn't name */
+#define HILL_MADV_HUGEPAGE   14
+#define HILL_MADV_NOHUGEPAGE 15
+#define HILL_MADV_COLLAPSE   25
+
+static Int   report_fd = -1;
+static void  (*item_hook)(void) = NULL;
+static ULong clock_reads = 0;
+static ULong random_state = 0x6172682d696e736eULL; /* "arh-insn" */
+static ULong frame_left = 0;   /* bytes of the current frame not yet read */
+static Bool  frames_ended = False;
+
+void VG_(hill_init) ( void )
+{
+   if (VG_(clo_hill_report_fd) < 0)
+      return;
+   report_fd = VG_(safe_fd)(VG_(clo_hill_report_fd));
+   if (report_fd < 0) {
+      VG_(umsg)("--hill-report-fd=%d: not an open descriptor\n",
+                VG_(clo_hill_report_fd));
+      VG_(exit)(1);
+   }
+}
+
+Bool VG_(hill_reporting) ( void )
+{
+   return report_fd >= 0;
+}
+
+void VG_(hill_report) ( const HChar* line )
+{
+   Int n = VG_(strlen)(line);
+   while (n > 0) {
+      Int w = VG_(write)(report_fd, line, n);
+      if (w <= 0)
+         return;
+      line += w;
+      n -= w;
+   }
+}
+
+void VG_(hill_set_item_hook) ( void (*hook)(void) )
+{
+   item_hook = hook;
+}
+
+/* Whether [a, a + len) is in the client's space. */
+static Bool in_space ( Addr a, SizeT len )
+{
+   return len == 0 || (a < VG_CLIENT_SPACE_END
+                       && len <= VG_CLIENT_SPACE_END - a);
+}
+
+/* Whether this file may write `len` bytes at `a` for the client. */
+static Bool writable ( Addr a, SizeT len )
+{
+   return len == 0 || (in_space(a, len)
+                       && VG_(am_is_valid_for_client)(a, len, VKI_PROT_WRITE));
+}
+
+/* Whether this file may read `len` bytes at `a` of the client's. */
+static Bool readable ( Addr a, SizeT len )
+{
+   return len == 0 || (in_space(a, len)
+                       && VG_(am_is_valid_for_client)(a, len, VKI_PROT_READ));
+}
+
+/* `bytes` written at `a` for the client, or -EFAULT. */
+static Word put ( Addr a, const void* bytes, SizeT len )
+{
+   if (!writable(a, len))
+      return -VKI_EFAULT;
+   VG_(memcpy)((void*)a, bytes, len);
+   return 0;
+}
+
+/* An iovec array of `n` at `a`: readable, and each buffer in the space. */
+static Bool iovecs_in_space ( Addr a, UWord n )
+{
+   if (n > 1024 || !readable(a, n * sizeof(struct vki_iovec)))
+      return False;
+   const struct vki_iovec* v = (const struct vki_iovec*)a;
+   for (UWord i = 0; i < n; i++)
+      if (!in_space((Addr)v[i].iov_base, v[i].iov_len))
+         return False;
+   return True;
+}
+
+/* The next clock reading on clock `id` in nanoseconds, or -EINVAL. */
+static Long now_ns ( UWord id )
+{
+   if (id >= HILL_CLOCK_IDS)
+      return -VKI_EINVAL;
+   clock_reads++;
+   Long ns = (Long)clock_reads * HILL_CLOCK_STEP;
+   /* CLOCK_REALTIME, _REALTIME_COARSE, _REALTIME_ALARM and _TAI */
+   Bool realtime = id == 0 || id == 5 || id == 8 || id == 11;
+   return realtime ? HILL_BASE_S * HILL_NS_PER_S + ns : ns;
+}
+
+/* splitmix64 */
+static ULong next_random ( void )
+{
+   ULong z = (random_state += 0x9e3779b97f4a7c15ULL);
+   z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+   z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+   return z ^ (z >> 31);
+}
+
+/* All `len` bytes from the real descriptor 0, waiting for them; False at
+   its end or an error. */
+static Bool read_input ( UChar* buf, Int len )
+{
+   while (len > 0) {
+      Int r = VG_(read)(0, buf, len);
+      if (r == -VKI_EINTR)
+         continue;
+      if (r <= 0)
+         return False;
+      buf += r;
+      len -= r;
+   }
+   return True;
+}
+
+/* read(0, buf, len) of framed input. */
+static Word framed_read ( Addr buf, UWord len )
+{
+   if (len == 0 || frames_ended)
+      return 0;
+   if (frame_left == 0) {
+      UChar header[8];
+      if (!read_input(header, sizeof header)) {
+         frames_ended = True;
+         return 0;
+      }
+      ULong n = 0;
+      for (Int i = 7; i >= 0; i--)
+         n = n << 8 | header[i];
+      if (n == 0) {
+         frames_ended = True;
+         return 0;
+      }
+      frame_left = n;
+      if (item_hook != NULL)
+         item_hook();
+   }
+   static UChar chunk[HILL_FRAME_CHUNK];
+   UWord n = len < sizeof chunk ? len : sizeof chunk;
+   if (frame_left < n)
+      n = frame_left;
+   if (!writable(buf, n))
+      return -VKI_EFAULT;
+   if (!read_input(chunk, (Int)n)) { /* a frame cut short: the input ends */
+      frames_ended = True;
+      return 0;
+   }
+   frame_left -= n;
+   VG_(memcpy)((void*)buf, chunk, n);
+   return (Word)n;
+}
+
+/* Answer the call: its result, or -errno. */
+#define ANSWER(expr)                                           \
+   do { Word r_ = (expr);                                      \
+        if (r_ < 0) SET_STATUS_Failure(-r_);                   \
+        else SET_STATUS_Success(r_);                           \
+        return True; } while (0)
+/* Let the call through to Valgrind's own wrapper and the kernel. */
+#define PASS return False
+
+Bool ML_(hill_syscall) ( ThreadId tid, SyscallArgs* args,
+                         /*OUT*/SyscallStatus* status )
+{
+   if (report_fd < 0)
+      return False;
+   UWord a1 = args->arg1, a2 = args->arg2, a3 = args->arg3, a4 = args->arg4;
+   UWord a5 = args->arg5;
+
+   if (VG_(clo_hill_frames) && a1 == 0) {
+      switch (args->sysno) {
+      case __NR_read:    ANSWER(framed_read(a2, a3));
+      case __NR_pread64:
+      case __NR_readv:   ANSWER(-VKI_EINVAL);
+      case __NR_lseek:   ANSWER(-VKI_ESPIPE);
+      default:           break;
+      }
+   }
+
+   switch (args->sysno) {
+   case __NR_read: case __NR_pread64:
+      if (a1 != 0) ANSWER(-VKI_EBADF);
+      if (!in_space(a2, a3)) ANSWER(-VKI_EFAULT);
+      PASS;
+   case __NR_readv:
+      if (a1 != 0) ANSWER(-VKI_EBADF);
+      if (!iovecs_in_space(a2, a3)) ANSWER(-VKI_EFAULT);
+      PASS;
+   case __NR_lseek:
+      if (a1 != 0) ANSWER(-VKI_EBADF);
+      PASS;
+   case __NR_write:
+      if (a1 != 1 && a1 != 2) ANSWER(-VKI_EBADF);
+      if (!in_space(a2, a3)) ANSWER(-VKI_EFAULT);
+      PASS;
+   case __NR_writev:
+      if (a1 != 1 && a1 != 2) ANSWER(-VKI_EBADF);
+      if (!iovecs_in_space(a2, a3)) ANSWER(-VKI_EFAULT);
+      PASS;
+   case __NR_close:
+      if (a1 > 2) ANSWER(-VKI_EBADF);
+      PASS;
+   case __NR_mmap:
+      /* Huge pages come from the host's pool, which would tell the
+         program how the host is set up: refused, the same everywhere. */
+      if (a4 & HILL_MAP_HUGETLB) ANSWER(-VKI_EINVAL);
+      if (!(a4 & VKI_MAP_ANONYMOUS)
+          && ((Int)a5 != 0 || VG_(clo_hill_frames)))
+         ANSWER(-VKI_EBADF);
+      PASS; /* where: the advisor keeps it in the space (aspacemgr) */
+   case __NR_futex:
+      switch (a2 & 0x7f) { /* without PRIVATE and CLOCK_REALTIME */
+      case 0: case 1: case 9: case 10: /* WAIT, WAKE, their BITSET forms */
+         if (!in_space(a1, 4)) ANSWER(-VKI_EFAULT);
+         if ((a2 & 0x7f) != 1 && (a2 & 0x7f) != 10 && a4 != 0
+             && !in_space(a4, sizeof(struct vki_timespec)))
+            ANSWER(-VKI_EFAULT);
+         PASS;
+      default:
+         ANSWER(-VKI_ENOSYS);
+      }
+   case __NR_set_tid_address:
+      ANSWER(HILL_TID); /* no thread ever exits but the program's own */
+   case __NR_mprotect: case __NR_munmap: case __NR_madvise:
+      /* Valgrind's own wrapper checks mprotect's and munmap's range, but
+         not madvise's, and MADV_DONTNEED would zero Valgrind's memory. */
+      if (!in_space(a1, a2)) ANSWER(-VKI_EFAULT);
+      /* Transparent huge pages: whether the host has them configured
+         decides the answer, so the advice succeeds and does nothing. */
+      if (args->sysno == __NR_madvise
+          && (a3 == HILL_MADV_HUGEPAGE || a3 == HILL_MADV_NOHUGEPAGE
+              || a3 == HILL_MADV_COLLAPSE))
+         ANSWER(0);
+      PASS;
+   case __NR_mremap:
+      if (!in_space(a1, a2)
+          || ((a4 & VKI_MREMAP_FIXED) && !in_space(a5, a3)))
+         ANSWER(-VKI_EFAULT);
+      PASS; /* a moved mapping: the advisor keeps it in the space */
+   case __NR_brk: case __NR_sched_yield: case __NR_rt_sigreturn:
+   case __NR_exit: case __NR_exit_group:
+      PASS;
+   case __NR_rt_sigaction:
+      if (!in_space(a2, sizeof(vki_sigaction_toK_t))
+          || !in_space(a3, sizeof(vki_sigaction_fromK_t)))
+         ANSWER(-VKI_EFAULT);
+      PASS;
+   case __NR_rt_sigprocmask:
+      if (!in_space(a2, a4) || !in_space(a3, a4)) ANSWER(-VKI_EFAULT);
+      PASS;
+   case __NR_sigaltstack:
+      /* Valgrind writes signal frames on the alternate stack itself. */
+      if (!in_space(a2, sizeof(vki_stack_t))) ANSWER(-VKI_EFAULT);
+      if (a1 != 0) {
+         if (!readable(a1, sizeof(vki_stack_t))) ANSWER(-VKI_EFAULT);
+         const vki_stack_t* ss = (const vki_stack_t*)a1;
+         if (!(ss->ss_flags & VKI_SS_DISABLE)
+             && !in_space((Addr)ss->ss_sp, ss->ss_size))
+            ANSWER(-VKI_EFAULT);
+      }
+      PASS;
+   case __NR_arch_prctl:
+      if (a1 == VKI_ARCH_GET_FS && !in_space(a2, sizeof(ULong)))
+         ANSWER(-VKI_EFAULT);
+      PASS;
+   case __NR_clock_gettime: {
+      Long ns = now_ns(a1);
+      if (ns < 0) ANSWER(ns);
+      struct vki_timespec ts = { ns / HILL_NS_PER_S, ns % HILL_NS_PER_S };
+      ANSWER(put(a2, &ts, sizeof ts));
+   }
+   case __NR_gettimeofday: {
+      Long ns = now_ns(0);
+      struct vki_timeval tv = { ns / HILL_NS_PER_S,
+                                ns % HILL_NS_PER_S / 1000 };
+      Int zone[2] = { 0, 0 };
+      if ((a1 != 0 && put(a1, &tv, sizeof tv) < 0)
+          || (a2 != 0 && put(a2, zone, sizeof zone) < 0))
+         ANSWER(-VKI_EFAULT);
+      ANSWER(0);
+   }
+   case __NR_time: {
+      Long s = now_ns(0) / HILL_NS_PER_S;
+      if (a1 != 0 && put(a1, &s, sizeof s) < 0) ANSWER(-VKI_EFAULT);
+      ANSWER(s);
+   }
+   case __NR_clock_getres: {
+      if (a1 >= HILL_CLOCK_IDS) ANSWER(-VKI_EINVAL);
+      struct vki_timespec one = { 0, 1 };
+      ANSWER(a2 != 0 ? put(a2, &one, sizeof one) : 0);
+   }
+   case __NR_nanosleep: case __NR_clock_nanosleep:
+      ANSWER(0);
+   case __NR_getrandom: {
+      UWord len = a2 > 33554431 ? 33554431 : a2; /* Linux's most a call */
+      if (!writable(a1, len)) ANSWER(-VKI_EFAULT);
+      UChar* out = (UChar*)a1;
+      for (UWord done = 0; done < len; done += 8) {
+         ULong r = next_random();
+         VG_(memcpy)(out + done, &r, len - done < 8 ? len - done : 8);
+      }
+      ANSWER(len);
+   }
+   case __NR_poll: case __NR_ppoll: {
+      if (a2 > 1024) ANSWER(-VKI_EINVAL);
+      if (!writable(a1, a2 * sizeof(struct vki_pollfd)))
+         ANSWER(-VKI_EFAULT);
+      struct vki_pollfd* fds = (struct vki_pollfd*)a1;
+      for (UWord i = 0; i < a2; i++)
+         fds[i].revents = 0;
+      ANSWER(0);
+   }
+   case __NR_clone:
+      if (a1 & VKI_CLONE_THREAD) {
+         VG_(hill_report)("thread\n");
+         VG_(exit)(HILL_EXIT_THREAD);
+      }
+      ANSWER(-VKI_ENOSYS);
+   default:
+      ANSWER(-VKI_ENOSYS);
+   }
+}
+
+#undef ANSWER
+#undef PASS
+
+#else /* !VGP_amd64_linux */
+
+void VG_(hill_init) ( void ) {}
+Bool VG_(hill_reporting) ( void ) { return False; }
+void VG_(hill_report) ( const HChar* line ) {}
+void VG_(hill_set_item_hook) ( void (*hook)(void) ) {}
+Bool ML_(hill_syscall) ( ThreadId tid, SyscallArgs* args,
+                         /*OUT*/SyscallStatus* status )
+{
+   return False;
+}
+
+#endif
+
