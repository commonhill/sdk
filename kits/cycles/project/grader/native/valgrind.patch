+/* Commonhill (PER-492): the table has no x87 rows of its own (lut-gen keeps
+ * measured instructions only, and uops.info measured no x87 on Zen 4), so its
+ * default priced every x87 instruction at 1.00 cycle: FDIV at an eighth of
+ * DIVSD, FSQRT at a thirteenth of SQRTSD, FSIN as a MOV. x87 arithmetic is
+ * priced as its SSE2 twin's row (the same work on a double; the twin's default
+ * row, as an x87 operand has no width of its own here). The microcoded ones
+ * have no twin and no published Zen 4 measurement under a licence the kit can
+ * use (LLVM's Zen 4 model gives them all a 100-cycle placeholder), so they are
+ * priced at Commonhill's own measurement on Zen 3 (a Ryzen 5 5600X, the kit's
+ * x87/measure.py): reciprocal throughput and latency, in whole cycles, each at
+ * one mid-range argument (FSIN's at 1.5); the latency varies with it. Every
+ * other x87 instruction (loads, stores, exchanges, compares, control) keeps its
+ * row: one cycle, about what Zen takes for them. */
+typedef struct {
+   unsigned id;
+   unsigned twin; /* an SSE2 instruction whose default row prices it, or 0 */
+   unsigned cy, cl; /* else these, centi-cycles */
+} ClgX87;
+
+static const ClgX87 clg_x87[] = {
+   { X86_INS_FADD, X86_INS_ADDSD, 0, 0 },     { X86_INS_FIADD, X86_INS_ADDSD, 0, 0 },
