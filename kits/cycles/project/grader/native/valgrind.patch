+   { X86_INS_FSUBR, X86_INS_SUBSD, 0, 0 },    { X86_INS_FSUBRP, X86_INS_SUBSD, 0, 0 },
+   { X86_INS_FISUB, X86_INS_SUBSD, 0, 0 },    { X86_INS_FISUBR, X86_INS_SUBSD, 0, 0 },
+   { X86_INS_FMUL, X86_INS_MULSD, 0, 0 },     { X86_INS_FMULP, X86_INS_MULSD, 0, 0 },
+   { X86_INS_FIMUL, X86_INS_MULSD, 0, 0 },
+   { X86_INS_FDIV, X86_INS_DIVSD, 0, 0 },     { X86_INS_FDIVP, X86_INS_DIVSD, 0, 0 },
+   { X86_INS_FDIVR, X86_INS_DIVSD, 0, 0 },    { X86_INS_FDIVRP, X86_INS_DIVSD, 0, 0 },
+   { X86_INS_FIDIV, X86_INS_DIVSD, 0, 0 },    { X86_INS_FIDIVR, X86_INS_DIVSD, 0, 0 },
+   { X86_INS_FSQRT, X86_INS_SQRTSD, 0, 0 },   { X86_INS_FRNDINT, X86_INS_ROUNDSD, 0, 0 },
+   { X86_INS_FSIN, 0, 3800, 15600 },          { X86_INS_FCOS, 0, 13400, 18200 },
+   { X86_INS_FSINCOS, 0, 5200, 14900 },       { X86_INS_FPTAN, 0, 3100, 11000 },
