diff --git a/coregrind/m_translate.c b/coregrind/m_translate.c
index cfd2b5144..7102591f0 100644
--- a/coregrind/m_translate.c
+++ b/coregrind/m_translate.c
@@ -225,6 +225,112 @@ static IRExpr* mk_ecu_Expr ( Addr guest_IP )
    return mkIRExpr_HWord( (HWord)ecu );
 }
 
+/* Commonhill: the guest's memory guard. All of the client's memory is below
+   VG_CLIENT_SPACE_END and none of Valgrind's is (pub_core_aspacemgr.h), but a
+   guest that can make any pointer could otherwise reach Valgrind's own memory,
+   the tool's counts included. So, before the tool sees a block, every guest
+   load, store, CAS, LL/SC and helper memory access gets a check that it ends
+   below VG_CLIENT_SPACE_END; one that doesn't ends the process with status 135
+   (EXIT_ESCAPE) before it happens, reporting nothing. The check is on the
+   client's IR, before the tool adds its own (which may access the tool's
+   memory), and costs a compare and a branch an access. */
+#if defined(VGP_amd64_linux)
+#define HILL_EXIT_ESCAPE 135
+
+static void hill_escape ( void )
+{
+   VG_(exit)(HILL_EXIT_ESCAPE);
+}
+
+/* Add to `out` the check of an access of `size` bytes at `addr` (an atom),
+   made only when `guard` (an atom of type Ity_I1, or NULL for always). */
+static void hill_add_check ( IRSB* out, IRExpr* addr, Int size,
+                             IRExpr* guard )
+{
+   vg_assert(size > 0 && (Addr)size < VG_CLIENT_SPACE_END);
+   vg_assert(typeOfIRExpr(out->tyenv, addr) == Ity_I64);
+   IRTemp past = newIRTemp(out->tyenv, Ity_I1);
+   addStmtToIRSB(out, IRStmt_WrTmp(past,
+      IRExpr_Binop(Iop_CmpLT64U,
+                   IRExpr_Const(IRConst_U64(VG_CLIENT_SPACE_END - size)),
+                   addr)));
+   IRExpr* bad = IRExpr_RdTmp(past);
+   if (guard != NULL) {
+      IRTemp both = newIRTemp(out->tyenv, Ity_I1);
+      addStmtToIRSB(out, IRStmt_WrTmp(both,
+                                      IRExpr_Binop(Iop_And1, guard, bad)));
+      bad = IRExpr_RdTmp(both);
+   }
+   IRDirty* d = unsafeIRDirty_0_N(0, "hill_escape",
+                                  VG_(fnptr_to_fnentry)(&hill_escape),
+                                  mkIRExprVec_0());
+   d->guard = bad;
+   addStmtToIRSB(out, IRStmt_Dirty(d));
+}
+
+static IRSB* hill_guard_client_accesses ( IRSB* sb_in )
+{
+   IRTypeEnv* tyenv = sb_in->tyenv;
+   IRSB* out = deepCopyIRSBExceptStmts(sb_in);
+   for (Int i = 0; i < sb_in->stmts_used; i++) {
+      IRStmt* st = sb_in->stmts[i];
+      switch (st->tag) {
+         case Ist_WrTmp:
+            if (st->Ist.WrTmp.data->tag == Iex_Load) {
+               IRExpr* ld = st->Ist.WrTmp.data;
+               hill_add_check(out, ld->Iex.Load.addr,
+                              sizeofIRType(ld->Iex.Load.ty), NULL);
+            }
+            break;
+         case Ist_Store:
+            hill_add_check(out, st->Ist.Store.addr,
+                           sizeofIRType(typeOfIRExpr(tyenv,
+                                                     st->Ist.Store.data)),
+                           NULL);
+            break;
+         case Ist_StoreG: {
+            IRStoreG* sg = st->Ist.StoreG.details;
+            hill_add_check(out, sg->addr,
+                           sizeofIRType(typeOfIRExpr(tyenv, sg->data)),
+                           sg->guard);
+            break;
+         }
+         case Ist_LoadG: {
+            IRLoadG* lg = st->Ist.LoadG.details;
+            IRType wide = Ity_INVALID, type = Ity_INVALID;
+            typeOfIRLoadGOp(lg->cvt, &wide, &type);
+            hill_add_check(out, lg->addr, sizeofIRType(type), lg->guard);
+            break;
+         }
+         case Ist_CAS: {
+            IRCAS* cas = st->Ist.CAS.details;
+            Int size = sizeofIRType(typeOfIRExpr(tyenv, cas->dataLo));
+            hill_add_check(out, cas->addr,
+                           cas->dataHi != NULL ? 2 * size : size, NULL);
+            break;
+         }
+         case Ist_LLSC: {
+            IRType ty = st->Ist.LLSC.storedata == NULL
+                           ? typeOfIRTemp(tyenv, st->Ist.LLSC.result)
+                           : typeOfIRExpr(tyenv, st->Ist.LLSC.storedata);
+            hill_add_check(out, st->Ist.LLSC.addr, sizeofIRType(ty), NULL);
+            break;
+         }
+         case Ist_Dirty: {
+            IRDirty* d = st->Ist.Dirty.details;
